# Supabase is used by the private AI server for its internal key and logs.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_SERVER_ONLY_KEY

# Polygon governance ledger
# auto uses simulation when no private key exists; live requires a funded key.
POLYGON_MODE=simulation
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_CHAIN_ID=80002
# POLYGON_PRIVATE_KEY=0xYOUR_AMOY_TEST_WALLET_PRIVATE_KEY

# Proposal decision and optimization pipeline
# model uses the local convaiinnovations/laya-typed-decisions checkpoint.
LAYA_MODE=model
# Keep LAYA on CPU by default so it does not compete with DeepSeek for VRAM.
LAYA_DEVICE=cpu
LAYA_RETRY_SECONDS=60
PYGAD_DECOMPOSITION_PROFILE=balanced
PYGAD_DECOMPOSITION_GENERATIONS=20

# Automatic eFlow tunnel supervisor
EFLOW_GATEWAY_ORIGIN=http://127.0.0.1:8322
# auto starts the embedded AI gateway if a full eFlow gateway is not already
# listening on this host. Set external only when EflowWeb owns port 8322.
EFLOW_GATEWAY_MODE=auto
# Comma-separated deployed browser origins. Omit to permit all origins for
# bearer-token requests during development.
# EFLOW_ALLOWED_ORIGINS=https://YOUR_EFLOW_FRONTEND.example
EFLOW_TUNNEL_RETRY_SECONDS=5
# Do not publish a new hostname until Cloudflare DNS and remote health work.
EFLOW_TUNNEL_PUBLIC_READY_TIMEOUT_SECONDS=90
EFLOW_TUNNEL_HEALTH_INTERVAL_SECONDS=5
EFLOW_TUNNEL_FAILURE_THRESHOLD=3
# CLOUDFLARED_PATH=C:\Program Files (x86)\cloudflared\cloudflared.exe

# Optional local control-panel configuration
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_PUBLIC_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://YOUR_PROJECT-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT
